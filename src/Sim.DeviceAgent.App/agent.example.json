{
  "agent": {
    "id": "agent-line-a-01",
    "displayName": "A line test host",
    "stateDirectory": "data",
    "tray": {
      "enabled": true
    }
  },
  "sinks": {
    "local": {
      "type": "wsServer",
      "bind": "127.0.0.1",
      "port": 18080
    }
  },
  "devices": [
    {
      "deviceId": "file-001",
      "type": "file",
      "deviceName": "\u6587\u4EF6\u63A5\u5165\uFF08\u793A\u4F8B\uFF09",
      "sinks": [
        "local"
      ],
      "directory": "data/in",
      "pattern": "*.*",
      "stableSeconds": 5,
      "pollIntervalSeconds": 5,
      "archiveDirectory": "data/archive",
      "errorDirectory": "data/error",
      "codec": {
        "type": "passthrough"
      }
    }
  ]
}
