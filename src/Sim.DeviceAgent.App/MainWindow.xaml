<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Sim.DeviceAgent.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarRoot" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="TitleBarDragRegion" Background="Transparent">
                <TextBlock
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="DeviceAgent" />
            </Grid>
        </Grid>

        <InfoBar
            x:Name="ErrorBar"
            Grid.Row="1"
            Margin="18,4,18,0"
            Title="配置或运行时错误"
            IsClosable="False"
            IsOpen="False"
            Severity="Error" />

        <TabView
            x:Name="MainTabs"
            Grid.Row="2"
            Margin="18,4,18,10"
            IsAddTabButtonVisible="False"
            TabWidthMode="SizeToContent">
            <TabViewItem Header="运行状态" IsClosable="False">
                <Grid Padding="0,12,0,0" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="设备" />
                        <ListView x:Name="DeviceList" SelectionMode="None" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="出口" />
                        <ListView x:Name="SinkList" SelectionMode="None" />
                    </StackPanel>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="配置" IsClosable="False">
                <Grid Padding="0,12,0,0" RowSpacing="8" ColumnSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="132" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListView
                        x:Name="ConfigNavList"
                        SelectionChanged="OnConfigNavSelectionChanged"
                        SelectionMode="Single">
                        <ListViewItem Content="设备" />
                        <ListViewItem Content="出口" />
                        <ListViewItem Content="Agent" />
                    </ListView>

                    <Grid Grid.Column="1">
                        <Grid x:Name="ConfigDevicesPanel" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="设备列表" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button Click="OnAddDeviceClick" Content="新建设备" />
                                        <Button Click="OnDeleteDeviceClick" Content="删除" />
                                    </StackPanel>
                                </Grid>
                                <ListView
                                    x:Name="ConfigDeviceList"
                                    Grid.Row="1"
                                    DisplayMemberPath="Display"
                                    SelectionChanged="OnConfigDeviceSelectionChanged"
                                    SelectionMode="Single" />
                            </Grid>

                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="DeviceForm" Padding="0,0,12,0" Spacing="14">
                                    <TextBlock FontWeight="SemiBold" Text="基本信息" />

                                    <Grid ColumnSpacing="12" RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.ColumnSpan="2" Spacing="4">
                                            <TextBlock FontSize="12" Opacity="0.7" Text="设备编号（唯一，保存后不可改）" />
                                            <TextBox x:Name="DeviceIdBox" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Grid.ColumnSpan="2" Spacing="4">
                                            <TextBlock FontSize="12" Opacity="0.7" Text="设备名称" />
                                            <TextBox x:Name="DeviceNameBox" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Spacing="4">
                                            <TextBlock FontSize="12" Opacity="0.7" Text="接入方式" />
                                            <ComboBox
                                                x:Name="TransportTypeCombo"
                                                HorizontalAlignment="Stretch"
                                                SelectionChanged="OnDeviceTransportChanged">
                                                <ComboBoxItem Content="serial" />
                                                <ComboBoxItem Content="tcp" />
                                                <ComboBoxItem Content="file" />
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                            <TextBlock FontSize="12" Opacity="0.7" Text="队列容量（16–1000000）" />
                                            <NumberBox
                                                x:Name="QueueCapacityBox"
                                                HorizontalAlignment="Stretch"
                                                Maximum="1000000"
                                                Minimum="16"
                                                SpinButtonPlacementMode="Compact" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                                            <TextBlock FontSize="12" Opacity="0.7" Text="启用" />
                                            <ToggleSwitch
                                                x:Name="DeviceEnabledToggle"
                                                OffContent="停用"
                                                OnContent="启用" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock FontWeight="SemiBold" Text="接入配置" />

                                    <StackPanel x:Name="SerialFields" Spacing="10">
                                        <Grid ColumnSpacing="12" RowSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.ColumnSpan="2" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="串口" />
                                                <Grid ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox
                                                        x:Name="PortCombo"
                                                        HorizontalAlignment="Stretch"
                                                        IsEditable="True" />
                                                    <Button
                                                        Grid.Column="1"
                                                        Click="OnRefreshPortsClick"
                                                        Content="刷新" />
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="波特率" />
                                                <ComboBox x:Name="BaudRateCombo" HorizontalAlignment="Stretch" IsEditable="True">
                                                    <ComboBoxItem Content="9600" />
                                                    <ComboBoxItem Content="19200" />
                                                    <ComboBoxItem Content="38400" />
                                                    <ComboBoxItem Content="57600" />
                                                    <ComboBoxItem Content="115200" />
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="读取超时（毫秒）" />
                                                <NumberBox
                                                    x:Name="ReadTimeoutBox"
                                                    HorizontalAlignment="Stretch"
                                                    Maximum="10000"
                                                    Minimum="50"
                                                    SpinButtonPlacementMode="Compact" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="数据位" />
                                                <ComboBox x:Name="DataBitsCombo" HorizontalAlignment="Stretch">
                                                    <ComboBoxItem Content="5" />
                                                    <ComboBoxItem Content="6" />
                                                    <ComboBoxItem Content="7" />
                                                    <ComboBoxItem Content="8" />
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="校验位" />
                                                <ComboBox x:Name="ParityCombo" HorizontalAlignment="Stretch">
                                                    <ComboBoxItem Content="None" />
                                                    <ComboBoxItem Content="Odd" />
                                                    <ComboBoxItem Content="Even" />
                                                    <ComboBoxItem Content="Mark" />
                                                    <ComboBoxItem Content="Space" />
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="停止位" />
                                                <ComboBox x:Name="StopBitsCombo" HorizontalAlignment="Stretch">
                                                    <ComboBoxItem Content="One" />
                                                    <ComboBoxItem Content="OnePointFive" />
                                                    <ComboBoxItem Content="Two" />
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="16">
                                                <ToggleSwitch x:Name="DtrToggle" OffContent="DTR 关" OnContent="DTR 开" />
                                                <ToggleSwitch x:Name="RtsToggle" OffContent="RTS 关" OnContent="RTS 开" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel x:Name="TcpFields" Spacing="10" Visibility="Collapsed">
                                        <Grid ColumnSpacing="12" RowSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.ColumnSpan="2" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="主机名或 IP" />
                                                <TextBox x:Name="TcpHostBox" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="端口（1–65535）" />
                                                <NumberBox
                                                    x:Name="TcpPortBox"
                                                    HorizontalAlignment="Stretch"
                                                    Maximum="65535"
                                                    Minimum="1"
                                                    SpinButtonPlacementMode="Compact" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="重连最小间隔（秒）" />
                                                <NumberBox
                                                    x:Name="TcpReconnectMinBox"
                                                    HorizontalAlignment="Stretch"
                                                    Maximum="3600"
                                                    Minimum="1"
                                                    SpinButtonPlacementMode="Compact" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="重连最大间隔（秒）" />
                                                <NumberBox
                                                    x:Name="TcpReconnectMaxBox"
                                                    HorizontalAlignment="Stretch"
                                                    Maximum="3600"
                                                    Minimum="1"
                                                    SpinButtonPlacementMode="Compact" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel x:Name="FileFields" Spacing="10" Visibility="Collapsed">
                                        <Grid ColumnSpacing="12" RowSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.ColumnSpan="4" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="监视目录" />
                                                <TextBox x:Name="FileDirectoryBox" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="文件匹配模式" />
                                                <TextBox x:Name="FilePatternBox" PlaceholderText="*.*" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="稳定判定（秒）" />
                                                <NumberBox
                                                    x:Name="StableSecondsBox"
                                                    HorizontalAlignment="Stretch"
                                                    Maximum="86400"
                                                    Minimum="0.1"
                                                    SmallChange="0.5"
                                                    SpinButtonPlacementMode="Compact" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="轮询间隔（秒）" />
                                                <NumberBox
                                                    x:Name="PollIntervalBox"
                                                    HorizontalAlignment="Stretch"
                                                    Maximum="86400"
                                                    Minimum="0.1"
                                                    SmallChange="0.5"
                                                    SpinButtonPlacementMode="Compact" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="归档目录" />
                                                <TextBox x:Name="ArchiveDirectoryBox" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="3" Grid.ColumnSpan="4" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="错误目录" />
                                                <TextBox x:Name="ErrorDirectoryBox" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock FontWeight="SemiBold" Text="解析器" />

                                    <Grid ColumnSpacing="12" RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="4">
                                            <TextBlock FontSize="12" Opacity="0.7" Text="类型" />
                                            <ComboBox
                                                x:Name="CodecTypeCombo"
                                                HorizontalAlignment="Stretch"
                                                SelectionChanged="OnCodecTypeChanged">
                                                <ComboBoxItem Content="delimiter" />
                                                <ComboBoxItem Content="passthrough" />
                                                <ComboBoxItem Content="csv" />
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock FontSize="12" Opacity="0.7" Text="编码" />
                                            <ComboBox x:Name="EncodingCombo" HorizontalAlignment="Stretch" IsEditable="True">
                                                <ComboBoxItem Content="utf-8" />
                                                <ComboBoxItem Content="ascii" />
                                                <ComboBoxItem Content="latin1" />
                                                <ComboBoxItem Content="utf-16" />
                                                <ComboBoxItem Content="utf-16-be" />
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Spacing="4">
                                            <TextBlock FontSize="12" Opacity="0.7" Text="单帧上限（字节）" />
                                            <NumberBox
                                                x:Name="MaxFrameBytesBox"
                                                HorizontalAlignment="Stretch"
                                                Maximum="4194304"
                                                Minimum="64"
                                                SpinButtonPlacementMode="Compact" />
                                        </StackPanel>

                                        <StackPanel x:Name="DelimiterPanel" Grid.Column="3" Spacing="4">
                                            <TextBlock FontSize="12" Opacity="0.7" Text="分隔符（支持 \r \n \t 转义）" />
                                            <TextBox x:Name="DelimiterBox" PlaceholderText="\r\n" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel x:Name="DelimiterFields" Spacing="10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="正则解析（命名组转为字段，可留空）" />
                                                <TextBox x:Name="ParsePatternBox" PlaceholderText="^RESULT,FORCE=(?&lt;force&gt;\d+\.\d+)N" />
                                            </StackPanel>

                                            <ToggleSwitch
                                                x:Name="ParseIgnoreCaseToggle"
                                                Grid.Column="1"
                                                VerticalAlignment="Bottom"
                                                OffContent="区分大小写"
                                                OnContent="忽略大小写" />
                                        </Grid>

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="过滤正则（不匹配的帧不入队，可留空）" />
                                                <TextBox x:Name="FilterPatternBox" PlaceholderText="^RESULT," />
                                            </StackPanel>

                                            <ToggleSwitch
                                                x:Name="FilterIgnoreCaseToggle"
                                                Grid.Column="1"
                                                VerticalAlignment="Bottom"
                                                OffContent="区分大小写"
                                                OnContent="忽略大小写" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel x:Name="PassthroughFields" Spacing="6" Visibility="Collapsed">
                                        <TextBlock
                                            FontSize="12"
                                            Opacity="0.7"
                                            Text="直通模式：整帧按文本上报，不做字段解析。"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel x:Name="CsvFields" Spacing="10" Visibility="Collapsed">
                                        <Grid ColumnSpacing="12" RowSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="CSV 分隔符（单个字符）" />
                                                <TextBox x:Name="CsvDelimiterBox" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Grid.ColumnSpan="3" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="表头" />
                                                <CheckBox
                                                    x:Name="CsvHasHeaderCheck"
                                                    Content="首行是表头（MVP 固定开启）"
                                                    IsChecked="True"
                                                    IsEnabled="False" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Spacing="4">
                                            <TextBlock FontSize="12" Opacity="0.7" Text="字段映射（每行一条：JSON 键=表头名；留空表示使用全部表头）" />
                                            <TextBox
                                                x:Name="CsvColumnsBox"
                                                AcceptsReturn="True"
                                                Height="90"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock FontWeight="SemiBold" Text="出口引用" />
                                    <StackPanel x:Name="DeviceSinkChecks" Spacing="4" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <Grid x:Name="ConfigSinksPanel" ColumnSpacing="12" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="出口列表" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button Click="OnAddSinkClick" Content="新增出口" />
                                        <Button Click="OnDeleteSinkClick" Content="删除" />
                                    </StackPanel>
                                </Grid>
                                <ListView
                                    x:Name="ConfigSinkList"
                                    Grid.Row="1"
                                    DisplayMemberPath="Display"
                                    SelectionChanged="OnConfigSinkSelectionChanged"
                                    SelectionMode="Single" />
                            </Grid>

                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="SinkForm" Padding="0,0,12,0" Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="4">
                                            <TextBlock FontSize="12" Opacity="0.7" Text="出口编号（创建后不可改）" />
                                            <TextBox x:Name="SinkIdBox" IsReadOnly="True" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock FontSize="12" Opacity="0.7" Text="类型（创建后不可改）" />
                                            <ComboBox
                                                x:Name="SinkTypeCombo"
                                                HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="wsClient" />
                                                <ComboBoxItem Content="wsServer" />
                                                <ComboBoxItem Content="rabbitmq" />
                                                <ComboBoxItem Content="kafka" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock
                                        FontSize="12"
                                        Opacity="0.7"
                                        Text="监听地址、令牌与 Origin 按出口生效；多个 wsServer 出口可使用不同地址/端口同时监听。"
                                        TextWrapping="Wrap" />

                                    <StackPanel x:Name="WsServerSinkFields" Spacing="10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.ColumnSpan="2" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="监听地址（仅回环，如 127.0.0.1）" />
                                                <TextBox x:Name="WsBindBox" PlaceholderText="127.0.0.1" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="监听端口（1–65535）" />
                                                <NumberBox
                                                    x:Name="WsPortBox"
                                                    HorizontalAlignment="Stretch"
                                                    Maximum="65535"
                                                    Minimum="1"
                                                    SpinButtonPlacementMode="Compact" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Spacing="4">
                                            <TextBlock FontSize="12" Opacity="0.7" Text="本机令牌（可选，hello.token）" />
                                            <PasswordBox x:Name="WsTokenBox" />
                                        </StackPanel>

                                        <StackPanel Spacing="4">
                                            <TextBlock FontSize="12" Opacity="0.7" Text="允许的浏览器 Origin（每行一个）" />
                                            <TextBox
                                                x:Name="WsOriginsBox"
                                                AcceptsReturn="True"
                                                Height="70"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel x:Name="WsClientSinkFields" Spacing="10" Visibility="Collapsed">
                                        <StackPanel Spacing="4">
                                            <TextBlock FontSize="12" Opacity="0.7" Text="中心地址（ws:// 或 wss://）" />
                                            <TextBox x:Name="CenterUrlBox" PlaceholderText="ws://127.0.0.1:18081/device" />
                                        </StackPanel>

                                        <StackPanel Spacing="4">
                                            <TextBlock FontSize="12" Opacity="0.7" Text="令牌（可选，写入 Authorization: Bearer）" />
                                            <PasswordBox x:Name="CenterTokenBox" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel x:Name="RabbitMqSinkFields" Spacing="10" Visibility="Collapsed">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.ColumnSpan="2" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="主机名或 IP" />
                                                <TextBox x:Name="MqHostBox" PlaceholderText="127.0.0.1" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="端口（默认 5672）" />
                                                <NumberBox
                                                    x:Name="MqPortBox"
                                                    HorizontalAlignment="Stretch"
                                                    Maximum="65535"
                                                    Minimum="1"
                                                    SpinButtonPlacementMode="Compact" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="Virtual Host" />
                                                <TextBox x:Name="MqVirtualHostBox" PlaceholderText="/" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="用户名" />
                                                <TextBox x:Name="MqUserNameBox" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="密码" />
                                                <PasswordBox x:Name="MqPasswordBox" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="交换机" />
                                                <TextBox x:Name="MqExchangeBox" PlaceholderText="sim.device-agent" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="交换机类型" />
                                                <ComboBox x:Name="MqExchangeTypeCombo" HorizontalAlignment="Stretch" IsEditable="True">
                                                    <ComboBoxItem Content="topic" />
                                                    <ComboBoxItem Content="direct" />
                                                    <ComboBoxItem Content="fanout" />
                                                    <ComboBoxItem Content="headers" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Spacing="4">
                                            <TextBlock FontSize="12" Opacity="0.7" Text="路由键模板（占位符：{agentId} {deviceId}）" />
                                            <TextBox x:Name="MqRoutingKeyBox" PlaceholderText="device.{deviceId}" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                            <ToggleSwitch x:Name="MqDurableToggle" OffContent="交换机非持久" OnContent="交换机持久" />
                                            <ToggleSwitch x:Name="MqPersistentToggle" OffContent="消息非持久" OnContent="消息持久" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel x:Name="KafkaSinkFields" Spacing="10" Visibility="Collapsed">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="Bootstrap Servers（逗号分隔 host:port）" />
                                                <TextBox x:Name="KafkaBootstrapBox" PlaceholderText="127.0.0.1:9092" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="主题（占位符：{agentId} {deviceId}）" />
                                                <TextBox x:Name="KafkaTopicBox" PlaceholderText="devices.{deviceId}" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Spacing="4">
                                            <TextBlock FontSize="12" Opacity="0.7" Text="消息键模板（默认 {agentId}:{deviceId}，同名键进入同一分区）" />
                                            <TextBox x:Name="KafkaMessageKeyBox" PlaceholderText="如 {agentId}:{deviceId}" />
                                        </StackPanel>

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="安全协议（plaintext / ssl / saslPlaintext / saslSsl）" />
                                                <ComboBox x:Name="KafkaSecurityProtocolCombo" HorizontalAlignment="Stretch" IsEditable="True">
                                                    <ComboBoxItem Content="plaintext" />
                                                    <ComboBoxItem Content="ssl" />
                                                    <ComboBoxItem Content="saslPlaintext" />
                                                    <ComboBoxItem Content="saslSsl" />
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="SASL 机制（plain / scramSha256 / scramSha512）" />
                                                <ComboBox x:Name="KafkaSaslMechanismCombo" HorizontalAlignment="Stretch" IsEditable="True">
                                                    <ComboBoxItem Content="plain" />
                                                    <ComboBoxItem Content="scramSha256" />
                                                    <ComboBoxItem Content="scramSha512" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="SASL 用户名" />
                                                <TextBox x:Name="KafkaSaslUsernameBox" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="SASL 密码" />
                                                <PasswordBox x:Name="KafkaSaslPasswordBox" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Spacing="4">
                                            <TextBlock FontSize="12" Opacity="0.7" Text="SSL CA 证书路径（可选，ssl / saslSsl 时使用）" />
                                            <TextBox x:Name="KafkaSslCaLocationBox" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel x:Name="ReliableSinkFields" Spacing="10">
                                        <Grid ColumnSpacing="12" RowSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="重连最小间隔（秒）" />
                                                <NumberBox
                                                    x:Name="SinkReconnectMinBox"
                                                    HorizontalAlignment="Stretch"
                                                    Maximum="3600"
                                                    Minimum="1"
                                                    SpinButtonPlacementMode="Compact" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="重连最大间隔（秒）" />
                                                <NumberBox
                                                    x:Name="SinkReconnectMaxBox"
                                                    HorizontalAlignment="Stretch"
                                                    Maximum="3600"
                                                    Minimum="1"
                                                    SpinButtonPlacementMode="Compact" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="单设备 spool 分段（MB）" />
                                                <NumberBox
                                                    x:Name="SpoolSegmentBox"
                                                    HorizontalAlignment="Stretch"
                                                    Maximum="1024"
                                                    Minimum="1"
                                                    SpinButtonPlacementMode="Compact" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" Spacing="4">
                                                <TextBlock FontSize="12" Opacity="0.7" Text="单设备 spool 配额（MB）" />
                                                <NumberBox
                                                    x:Name="SpoolMaxBox"
                                                    HorizontalAlignment="Stretch"
                                                    Maximum="1048576"
                                                    Minimum="1"
                                                    SpinButtonPlacementMode="Compact" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Spacing="4">
                                            <TextBlock FontSize="12" Opacity="0.7" Text="spool 目录（可留空使用默认目录）" />
                                            <TextBox x:Name="SpoolDirectoryBox" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <ScrollViewer x:Name="ConfigAgentPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel Padding="0,0,12,0" Spacing="12">
                                <Grid ColumnSpacing="12" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Spacing="4">
                                        <TextBlock FontSize="12" Opacity="0.7" Text="Agent 标识（只读）" />
                                        <TextBox x:Name="AgentIdText" IsReadOnly="True" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock FontSize="12" Opacity="0.7" Text="显示名称" />
                                        <TextBox x:Name="AgentDisplayNameBox" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="4">
                                        <TextBlock FontSize="12" Opacity="0.7" Text="状态目录（只读）" />
                                        <TextBox x:Name="AgentStateDirectoryText" IsReadOnly="True" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="24">
                                        <ToggleSwitch
                                            x:Name="AgentTrayToggle"
                                            Header="托盘"
                                            OffContent="停用"
                                            OnContent="启用" />
                                        <ToggleSwitch
                                            x:Name="StartWithWindowsToggle"
                                            Header="开机自启"
                                            OffContent="关闭"
                                            OnContent="开启"
                                            Toggled="OnStartWithWindowsToggled" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.6"
                                    Text="本机 WebSocket 监听地址、令牌与 Origin 白名单已归属到各 wsServer 出口，请在“出口”页配置。agent.id、stateDirectory 修改后需要重启，界面暂不提供编辑；托盘开关在下次启动时生效。"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.6"
                                    Text="登录 Windows 后由守护进程拉起并只驻留托盘；主程序异常退出会自动重启，托盘“退出”会同时结束守护进程。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <StackPanel
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="SaveConfigButton"
                            Click="OnSaveConfigClick"
                            Content="保存并应用"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Name="NewConfigButton"
                            Click="OnNewConfigClick"
                            Content="新建默认配置"
                            Visibility="Collapsed" />
                        <Button Click="OnReloadEditorClick" Content="从磁盘重新载入" />
                        <Button Click="OnOpenConfigClick" Content="打开配置文件" />
                        <TextBlock
                            x:Name="SaveStatusText"
                            VerticalAlignment="Center"
                            Opacity="0.7" />
                    </StackPanel>
                </Grid>
            </TabViewItem>
        </TabView>

        <TextBlock
            x:Name="ConfigText"
            Grid.Row="3"
            Margin="24,0,24,12"
            FontSize="12"
            Opacity="0.7"
            TextWrapping="Wrap" />

        <InfoBar
            x:Name="ConfigInfoBar"
            Grid.Row="2"
            MaxWidth="440"
            Margin="0,0,18,16"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Canvas.ZIndex="100"
            IsClosable="True"
            IsOpen="False" />
    </Grid>
</Window>
