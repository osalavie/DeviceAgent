{
  "agent": {
    "id": "agent-line-a-01",
    "displayName": "A line test host",
    "stateDirectory": "./data/state",
    "tray": {
      "enabled": true
    }
  },
  "sinks": {
    "local": {
      "type": "wsServer",
      "bind": "127.0.0.1",
      "port": 18080,
      "allowedOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173"
      ],
      "token": ""
    },
    "mq": {
      "type": "rabbitmq",
      "host": "127.0.0.1",
      "port": 5672,
      "virtualHost": "/",
      "userName": "guest",
      "password": "guest",
      "exchange": "sim.device-agent",
      "exchangeType": "topic",
      "routingKey": "device.{deviceType}.{deviceId}",
      "durable": true,
      "persistent": true,
      "reconnectMinSeconds": 1,
      "reconnectMaxSeconds": 30,
      "spoolSegmentMegabytes": 64,
      "spoolMaxMegabytes": 1024,
      "spoolDirectory": "./data/spool/mq"
    }
  },
  "devices": [
    {
      "deviceId": "PT-002",
      "type": "file",
      "deviceType": "pullTest",
      "deviceName": "Wire pull tester 02 (file)",
      "directory": "./data/in",
      "pattern": "PT02_*.csv",
      "stableSeconds": 5,
      "pollIntervalSeconds": 5,
      "archiveDirectory": "./data/archive",
      "errorDirectory": "./data/error",
      "codec": {
        "type": "csv",
        "csvDelimiter": ",",
        "hasHeader": true,
        "encoding": "utf-8",
        "columns": {
          "sampleId": "Sample",
          "force": "ForceN"
        }
      },
      "sinks": ["local", "mq"]
    }
  ]
}
